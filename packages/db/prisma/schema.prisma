// Acreflow data model.
// INVARIANTS baked in:
//  1. Money is integer cents -> BigInt columns named *Cents.
//  2. Audit trail (AuditLog) + period locking (AccountingPeriod).
//  6. Categories map to Schedule F via Account.scheduleFCode.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity / multi-entity (Phase 8-ready) ----------
model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String?
  passwordHash String? // scrypt "salt:hash"; null = no password set yet
  memberships  Membership[]
  createdAt    DateTime     @default(now())
}

model Farm {
  id                    String               @id @default(uuid())
  name                  String
  externalId            String?              @unique // dataset business_id, e.g. BIZ-RCK
  ownerName             String?
  location              String?
  structure             String? // sole prop | LLC (partnership) | ...
  acres                 Decimal?             @db.Decimal(12, 2)
  accountingMethod      String?
  profile               Json? // free-form business profile (goals, challenges, labor)
  reportCutoff          DateTime? // last closed month-end for actuals (test farms: 2026-09-30)
  ownerLaborChargeCents BigInt? // annual owner labor & management charge used by return ratios
  enterprises           Enterprise[]
  vendors               Vendor[]
  bills                 Bill[]
  assets                Asset[]
  parcels               LandParcel[]
  cropSeasons           CropSeason[]
  animals               Animal[]
  inventorySnapshots    InventorySnapshot[]
  production            ProductionRecord[]
  laborEntries          LaborEntry[]
  weather               WeatherMonth[]
  openingBalances       OpeningBalance[]
  transfers             EnterpriseTransfer[]
  enterpriseBudgets     EnterpriseBudget[]
  budgetMonths          BudgetMonth[]
  forecastAssumptions   ForecastAssumption[]
  scenarioLevers        ScenarioLever[]
  semenEvents           SemenEvent[]
  bullValuations        BullValuation[]
  reproduction          ReproductionYear[]
  processedAnimals      ProcessedAnimal[]
  insightRefs           InsightReference[]
  memberships           Membership[]
  accounts              Account[]
  transactions          Transaction[]
  inventory             InventoryItem[]
  liabilities           Liability[]
  leases                Lease[]
  budgets               Budget[]
  goals                 FinancialGoal[]
  invoices              Invoice[]
  customers             Customer[]
  plans                 ProductionPlan[]
  periods               AccountingPeriod[]
  alerts                Alert[]
  importBatches         ImportBatch[]
  alertSettings         AlertSetting[]
  alertDismissals       AlertDismissal[]
  createdAt             DateTime             @default(now())
  HerdFlowMonth         HerdFlowMonth[]
  LandValuation         LandValuation[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Membership {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String
  farm   Farm   @relation(fields: [farmId], references: [id])
  farmId String
  role   Role   @default(OWNER)

  @@unique([userId, farmId])
}

// ---------- Chart of accounts (Schedule F spine) ----------
enum AccountKind {
  INCOME
  EXPENSE
  BALANCE // balance-sheet cash flows (loan proceeds/principal, capex, owner draws)
}

model Account {
  id            String        @id @default(uuid())
  farm          Farm          @relation(fields: [farmId], references: [id])
  farmId        String
  code          String // e.g. "feed", "crop_sales"
  label         String
  kind          AccountKind
  scheduleFCode String // -> @fl/core SCHEDULE_F ("" for balance-sheet accounts)
  // Statement mapping. section: REV | COP | OVH | INT | DEP | GAIN | INVCHG | LVCHG | XFER | CASHBS
  section       String        @default("")
  statementLine String?
  cashFlowClass String?
  transactions  Transaction[]

  @@unique([farmId, code])
}

// ---------- Ledger ----------
model Transaction {
  id                 String         @id @default(uuid())
  farm               Farm           @relation(fields: [farmId], references: [id])
  farmId             String
  date               DateTime // accrual date: when income was earned / cost incurred
  cashDate           DateTime? // when cash moved; null = unpaid (AR/AP) or non-cash adjustment
  expectedCashDate   DateTime?
  dueDate            DateTime?
  cashEffectCents    BigInt? // signed cash impact (+ inflow); null for non-cash adjustments
  entryType          String         @default("ledger") // ledger | adjustment (month-end non-cash: DEP, INVCHG, LVCHG, XFER, GAIN)
  description        String
  account            Account        @relation(fields: [accountId], references: [id])
  accountId          String
  amountCents        BigInt // signed: income +, expense -
  vendor             String? // counterparty display name
  vendorRef          Vendor?        @relation(fields: [vendorId], references: [id])
  vendorId           String?
  customer           Customer?      @relation(fields: [customerId], references: [id])
  customerId         String?
  enterprise         Enterprise?    @relation(fields: [enterpriseId], references: [id])
  enterpriseId       String?
  bill               Bill?          @relation(fields: [billId], references: [id])
  billId             String?
  asset              Asset?         @relation(fields: [assetId], references: [id])
  assetId            String?
  cropSeason         CropSeason?    @relation(fields: [cropSeasonId], references: [id])
  cropSeasonId       String?
  animal             Animal?        @relation(fields: [animalId], references: [id])
  animalId           String?
  quantity           Decimal?       @db.Decimal(16, 4)
  unit               String?
  unitPrice          Decimal?       @db.Decimal(16, 4)
  paymentMethod      String?
  relatedInventory   InventoryItem? @relation(fields: [relatedInventoryId], references: [id])
  relatedInventoryId String?
  relatedLabel       String? // free-text related item pending FK reconciliation (Phase 1 import)
  source             String         @default("manual") // manual | import | ai_quicklog | receipt | auto_post
  // import + reconciliation (Phase 1)
  importBatch        ImportBatch?   @relation(fields: [importBatchId], references: [id])
  importBatchId      String?
  externalId         String? // OFX FITID or bank-provided id; stable across re-imports
  dedupeHash         String? // hash(date, amountCents, normalized description)
  reconciled         Boolean        @default(false)
  reconciledAt       DateTime?
  // obligation auto-posting (Phase 3): trace a payment back to its loan/lease
  liability          Liability?     @relation("LiabilityPayments", fields: [liabilityId], references: [id])
  liabilityId        String?
  lease              Lease?         @relation("LeasePayments", fields: [leaseId], references: [id])
  leaseId            String?
  invoice            Invoice?       @relation("InvoicePayments", fields: [invoiceId], references: [id])
  invoiceId          String?
  createdAt          DateTime       @default(now())

  @@index([farmId, date])
  @@index([farmId, cashDate])
  @@index([farmId, enterpriseId])
  @@index([farmId, dedupeHash])
  @@index([farmId, externalId])
}

// ---------- Import batches (Phase 1: CSV/OFX) ----------
model ImportBatch {
  id             String        @id @default(uuid())
  farm           Farm          @relation(fields: [farmId], references: [id])
  farmId         String
  source         String // csv | ofx
  filename       String?
  rowCount       Int           @default(0)
  importedCount  Int           @default(0)
  duplicateCount Int           @default(0)
  transactions   Transaction[]
  createdAt      DateTime      @default(now())
}

// ---------- Revenue / invoicing ----------
model Customer {
  id               String        @id @default(uuid())
  farm             Farm          @relation(fields: [farmId], references: [id])
  farmId           String
  externalId       String?
  name             String
  email            String?
  customerType     String?
  paymentTermsDays Int?
  location         String?
  notes            String?
  invoices         Invoice[]
  transactions     Transaction[]

  @@unique([farmId, externalId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id                String            @id @default(uuid())
  farm              Farm              @relation(fields: [farmId], references: [id])
  farmId            String
  number            String
  customer          Customer          @relation(fields: [customerId], references: [id])
  customerId        String
  status            InvoiceStatus     @default(DRAFT)
  issuedAt          DateTime
  dueAt             DateTime
  totalCents        BigInt
  paidAt            DateTime?
  externalId        String?
  description       String?
  enterprise        Enterprise?       @relation(fields: [enterpriseId], references: [id])
  enterpriseId      String?
  amountPaidCents   BigInt            @default(0)
  expectedPaymentAt DateTime?
  lineItems         InvoiceLineItem[]
  payments          Transaction[]     @relation("InvoicePayments")

  @@unique([farmId, number])
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(14, 4)
  unitCents   BigInt
  amountCents BigInt
}

// ---------- Inventory / assets ----------
enum InventoryCategory {
  LIVESTOCK
  FEED
  CROPS
  EQUIPMENT
  SUPPLIES
}

enum BasisType {
  RAISED
  PURCHASED
}

model InventoryItem {
  id              String            @id @default(uuid())
  farm            Farm              @relation(fields: [farmId], references: [id])
  farmId          String
  category        InventoryCategory
  name            String
  quantity        Decimal           @db.Decimal(14, 4)
  unit            String // head, bales, bushels, units
  location        String?
  // valuation
  unitValueCents  BigInt? // manual/override per-unit value
  marketSymbol    String? // for mark-to-market (Phase 2)
  estValueCents   BigInt? // computed
  // tax basis (Phase 2)
  basisType       BasisType?
  costBasisCents  BigInt?
  acquiredAt      DateTime?
  // depreciation (equipment)
  usefulLifeYears Int?
  salvageCents    BigInt?
  transactions    Transaction[]
  createdAt       DateTime          @default(now())
}

// ---------- Commodity prices (Phase 2 mark-to-market) ----------
// Global quote store; latest row per symbol wins. A live USDA/CME provider can
// upsert here behind a flag — for now quotes are seeded/manual. Per-item manual
// overrides live on InventoryItem.unitValueCents.
model CommodityPrice {
  id         String   @id @default(uuid())
  symbol     String // e.g. LE=F (live cattle), ZW=F (wheat)
  label      String?
  unit       String // display unit the price is quoted in (head, bushel)
  priceCents BigInt // price per inventory unit
  source     String   @default("manual") // usda | cme | manual
  asOf       DateTime @default(now())

  @@index([symbol, asOf])
}

// ---------- Liabilities ----------
enum LiabilityType {
  EQUIPMENT_LOAN
  OPERATING_LINE
  MORTGAGE
  OTHER
}

model Liability {
  id               String              @id @default(uuid())
  farm             Farm                @relation(fields: [farmId], references: [id])
  farmId           String
  type             LiabilityType
  name             String
  lender           String?
  originalCents    BigInt
  balanceCents     BigInt
  ratePct          Decimal             @db.Decimal(6, 3)
  nextPaymentAt    DateTime?
  paymentCents     BigInt?
  paymentFreq      String              @default("monthly") // monthly | quarterly | semiannual | annual
  externalId       String?
  debtType         String? // Land loan | Equipment loan | Vehicle loan | Breeding stock note | ...
  purpose          String?
  collateral       String?
  rateType         String? // Fixed | Variable
  originatedAt     DateTime?
  firstPaymentAt   DateTime?
  maturityAt       DateTime?
  numberOfPayments Int?
  limitCents       BigInt? // operating line limit
  payments         Transaction[]       @relation("LiabilityPayments")
  schedule         LoanScheduleEntry[]
  assets           Asset[]
  createdAt        DateTime            @default(now())

  @@unique([farmId, externalId])
}

model LoanScheduleEntry {
  id                 String    @id @default(uuid())
  liability          Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
  liabilityId        String
  number             Int
  dueDate            DateTime
  paymentCents       BigInt
  interestCents      BigInt
  principalCents     BigInt
  endingBalanceCents BigInt
  status             String // Paid | Scheduled

  @@unique([liabilityId, number])
}

// ---------- Leases ----------
enum LeaseType {
  CASH_RENT
  CROP_SHARE
}

model Lease {
  id              String        @id @default(uuid())
  farm            Farm          @relation(fields: [farmId], references: [id])
  farmId          String
  type            LeaseType
  name            String
  lessor          String?
  acres           Decimal       @db.Decimal(12, 2)
  termStart       DateTime
  termEnd         DateTime
  annualRentCents BigInt? // null for crop share
  paymentFreq     String        @default("annual") // annual | semiannual | quarterly | monthly
  nextPaymentAt   DateTime? // next rent due date (cash rent)
  payments        Transaction[] @relation("LeasePayments")
  createdAt       DateTime      @default(now())
}

// ---------- Budgets & goals ----------
enum BudgetPeriod {
  MONTHLY
  ANNUAL
}

model Budget {
  id          String       @id @default(uuid())
  farm        Farm         @relation(fields: [farmId], references: [id])
  farmId      String
  period      BudgetPeriod
  year        Int
  month       Int? // 1-12 when MONTHLY
  accountCode String
  amountCents BigInt

  @@unique([farmId, period, year, month, accountCode])
}

model FinancialGoal {
  id           String    @id @default(uuid())
  farm         Farm      @relation(fields: [farmId], references: [id])
  farmId       String
  name         String
  kind         String // savings | income_target
  targetCents  BigInt
  currentCents BigInt    @default(0)
  dueAt        DateTime?
  note         String?
}

// ---------- Production planning ----------
model ProductionPlan {
  id      String    @id @default(uuid())
  farm    Farm      @relation(fields: [farmId], references: [id])
  farmId  String
  title   String
  kind    String // planting | calving | harvest | breeding | other
  startAt DateTime
  endAt   DateTime?
  note    String?
}

// ---------- Audit + period lock (Invariant 2) ----------
model AuditLog {
  id       String   @id @default(uuid())
  farmId   String
  actorId  String?
  action   String // create | update | delete | lock | unlock | post
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([farmId, entity, entityId])
}

model AccountingPeriod {
  id       String    @id @default(uuid())
  farm     Farm      @relation(fields: [farmId], references: [id])
  farmId   String
  year     Int
  locked   Boolean   @default(false)
  lockedAt DateTime?

  @@unique([farmId, year])
}

// ---------- Alerts (Phase 4) ----------
enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Alert {
  id        String        @id @default(uuid())
  farm      Farm          @relation(fields: [farmId], references: [id])
  farmId    String
  type      String // payment_due | invoice_overdue | lease_expiring | budget_over
  severity  AlertSeverity @default(INFO)
  message   String
  dueAt     DateTime?
  dismissed Boolean       @default(false)
  createdAt DateTime      @default(now())
}

// Phase 4: alerts are computed live by the rules engine. We persist only the
// per-rule settings and the set of dismissed alert keys.
model AlertSetting {
  id       String  @id @default(uuid())
  farm     Farm    @relation(fields: [farmId], references: [id])
  farmId   String
  type     String // AlertType
  enabled  Boolean @default(true)
  leadDays Int     @default(30)

  @@unique([farmId, type])
}

model AlertDismissal {
  id        String   @id @default(uuid())
  farm      Farm     @relation(fields: [farmId], references: [id])
  farmId    String
  key       String // stable alert key, e.g. "invoice_overdue:<id>"
  createdAt DateTime @default(now())

  @@unique([farmId, key])
}

// ================= Roadmap 2 (Phase 9): data model v2 =================

model Enterprise {
  id           String        @id @default(uuid())
  farm         Farm          @relation(fields: [farmId], references: [id])
  farmId       String
  code         String // e.g. COM, BRD, PRD-TOM, OVH
  externalId   String? // dataset enterprise_id
  name         String
  type         String? // livestock | crop | service | lease | overhead ...
  parent       Enterprise?   @relation("EnterpriseTree", fields: [parentId], references: [id])
  parentId     String?
  children     Enterprise[]  @relation("EnterpriseTree")
  notes        String?
  transactions Transaction[]
  invoices     Invoice[]
  bills        Bill[]
  parcels      LandParcel[]
  cropSeasons  CropSeason[]

  @@unique([farmId, code])
}

/// Internal movement of animals (or semen) between enterprises at market value. Nets to zero.
model EnterpriseTransfer {
  id               String   @id @default(uuid())
  farm             Farm     @relation(fields: [farmId], references: [id])
  farmId           String
  externalId       String?
  date             DateTime
  fromEnterpriseId String
  toEnterpriseId   String
  amountCents      BigInt
  head             Int?
  animalClass      String?
  description      String?
}

model Vendor {
  id               String        @id @default(uuid())
  farm             Farm          @relation(fields: [farmId], references: [id])
  farmId           String
  externalId       String?
  name             String
  category         String?
  paymentTermsDays Int?
  location         String?
  notes            String?
  bills            Bill[]
  transactions     Transaction[]

  @@unique([farmId, externalId])
}

/// Accounts payable: a vendor bill bought on account.
model Bill {
  id                String        @id @default(uuid())
  farm              Farm          @relation(fields: [farmId], references: [id])
  farmId            String
  number            String // dataset bill_id
  vendor            Vendor        @relation(fields: [vendorId], references: [id])
  vendorId          String
  enterprise        Enterprise?   @relation(fields: [enterpriseId], references: [id])
  enterpriseId      String?
  billDate          DateTime
  dueDate           DateTime
  category          String?
  accountCode       String?
  description       String?
  amountCents       BigInt
  amountPaidCents   BigInt        @default(0)
  status            String // Paid | Open | Overdue
  paidAt            DateTime?
  expectedPaymentAt DateTime?
  transactions      Transaction[]

  @@unique([farmId, number])
}

/// Fixed-asset register. Land is carried at cost; everything else straight-line monthly.
model Asset {
  id                    String              @id @default(uuid())
  farm                  Farm                @relation(fields: [farmId], references: [id])
  farmId                String
  externalId            String?
  description           String
  category              String // Land | Buildings & improvements | Machinery & equipment | Vehicles
  enterpriseAllocation  String?
  purchasedAt           DateTime
  originalCostCents     BigInt
  financing             String?
  liability             Liability?          @relation(fields: [liabilityId], references: [id])
  liabilityId           String?
  usefulLifeYears       Int?
  salvageCents          BigInt              @default(0)
  depreciationMethod    String?
  estCurrentValueCents  BigInt?
  repairsByYear         Json? // {"2023": cents, ...}
  usage                 String?
  maintenanceNotes      String?
  disposedAt            DateTime?
  disposalProceedsCents BigInt?
  notes                 String?
  status                String              @default("In service")
  depreciation          AssetDepreciation[]
  transactions          Transaction[]

  @@unique([farmId, externalId])
}

model AssetDepreciation {
  id           String  @id @default(uuid())
  asset        Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId      String
  enterpriseId String?
  year         Int
  amountCents  BigInt
}

model LandParcel {
  id           String      @id @default(uuid())
  farm         Farm        @relation(fields: [farmId], references: [id])
  farmId       String
  externalId   String?
  name         String
  acres        Decimal     @db.Decimal(12, 2)
  use          String?
  tenure       String? // owned | leased-out | leased-in
  enterprise   Enterprise? @relation(fields: [enterpriseId], references: [id])
  enterpriseId String?
}

model CropSeason {
  id              String        @id @default(uuid())
  farm            Farm          @relation(fields: [farmId], references: [id])
  farmId          String
  externalId      String?
  enterprise      Enterprise?   @relation(fields: [enterpriseId], references: [id])
  enterpriseId    String?
  crop            String
  fieldId         String?
  year            Int
  acres           Decimal       @db.Decimal(12, 2)
  irrigated       Boolean?
  plantedAt       DateTime?
  harvestStart    DateTime?
  harvestEnd      DateTime?
  expectedYield   Decimal?      @db.Decimal(14, 4)
  actualYield     Decimal?      @db.Decimal(14, 4)
  yieldUnit       String?
  totalProduction Decimal?      @db.Decimal(16, 4)
  expectedPrice   Decimal?      @db.Decimal(14, 4)
  actualAvgPrice  Decimal?      @db.Decimal(14, 4)
  qtySold         Decimal?      @db.Decimal(16, 4)
  extra           Json? // farm-specific columns (cuttings, qty_lost, qty_stored_end, ...)
  dataType        String?
  transactions    Transaction[]

  @@unique([farmId, externalId])
}

/// Operational logs: hay cuttings, market days, egg production, separator hours, animal units.
model ProductionRecord {
  id           String   @id @default(uuid())
  farm         Farm     @relation(fields: [farmId], references: [id])
  farmId       String
  externalId   String?
  enterpriseId String?
  date         DateTime
  recordType   String
  item         String?
  quantity     Decimal? @db.Decimal(16, 4)
  unit         String?
  extra        Json?
  dataType     String?
}

model WeatherMonth {
  id         String  @id @default(uuid())
  farm       Farm    @relation(fields: [farmId], references: [id])
  farmId     String
  year       Int
  month      Int
  rainfallIn Decimal @db.Decimal(8, 2)
  normalIn   Decimal @db.Decimal(8, 2)
  dataType   String? // actual | assumption
  note       String?

  @@unique([farmId, year, month])
}

model Animal {
  id                String        @id @default(uuid())
  farm              Farm          @relation(fields: [farmId], references: [id])
  farmId            String
  externalId        String
  species           String
  sex               String?
  breed             String?
  nameOrTag         String?
  birthDate         DateTime?
  origin            String? // born | purchased
  acquiredAt        DateTime?
  damId             String? // externalId of dam
  sireId            String? // externalId of sire
  currentClass      String?
  status            String?
  dispositionDate   DateTime?
  dispositionType   String?
  dispositionDetail String?
  weaningWeightLb   Decimal?      @db.Decimal(10, 2)
  saleWeightLb      Decimal?      @db.Decimal(10, 2)
  salePriceCents    BigInt?
  grade             String?
  aiSired           Boolean?
  transactions      Transaction[]

  @@unique([farmId, externalId])
}

model InventorySnapshot {
  id                 String   @id @default(uuid())
  farm               Farm     @relation(fields: [farmId], references: [id])
  farmId             String
  asOf               DateTime
  itemKey            String
  item               String
  category           String // Feed - hay | Crops - grain | Growing crops | Livestock - market | ...
  enterpriseId       String?
  quantity           Decimal  @db.Decimal(16, 4)
  unit               String?
  costPerUnit        Decimal? @db.Decimal(16, 4)
  marketPerUnit      Decimal? @db.Decimal(16, 4)
  costBasisCents     BigInt
  marketValueCents   BigInt
  bsValuation        String // market | cost
  acquiredOrProduced String?
  expectedUseOrSale  String?
  location           String?

  @@index([farmId, asOf])
}

model LaborEntry {
  id              String   @id @default(uuid())
  farm            Farm     @relation(fields: [farmId], references: [id])
  farmId          String
  month           DateTime
  enterpriseId    String?
  workerType      String // hired | family (unpaid) | ...
  worker          String?
  hours           Decimal  @db.Decimal(10, 2)
  hourlyCostCents BigInt?
  wagesPaidCents  BigInt   @default(0)
  note            String?
}

/// Balances carried in at the start of the books (e.g. 12/31/2022).
model OpeningBalance {
  id          String   @id @default(uuid())
  farm        Farm     @relation(fields: [farmId], references: [id])
  farmId      String
  asOf        DateTime
  line        String // cash | contributed_capital | retained_earnings | operating_line | land_market_value
  amountCents BigInt

  @@unique([farmId, line])
}

/// Annual operating plan by enterprise (set each January).
model EnterpriseBudget {
  id                    String  @id @default(uuid())
  farm                  Farm    @relation(fields: [farmId], references: [id])
  farmId                String
  year                  Int
  enterpriseId          String? // null = TOTAL
  plannedRevenueCents   BigInt
  plannedExpensesCents  BigInt
  plannedNetIncomeCents BigInt
}

model BudgetMonth {
  id                String   @id @default(uuid())
  farm              Farm     @relation(fields: [farmId], references: [id])
  farmId            String
  monthEnd          DateTime
  revenueCents      BigInt
  copCents          BigInt
  overheadCents     BigInt
  depreciationCents BigInt
  interestCents     BigInt

  @@unique([farmId, monthEnd])
}

model ForecastAssumption {
  id         String  @id @default(uuid())
  farm       Farm    @relation(fields: [farmId], references: [id])
  farmId     String
  scenario   String // Base | Optimistic | Downside
  driver     String
  assumption String
  note       String?
}

model ScenarioLever {
  id              String   @id @default(uuid())
  farm            Farm     @relation(fields: [farmId], references: [id])
  farmId          String
  externalId      String?
  question        String
  driver          String
  baseValue       String?
  scenarioChange  String?
  estimatedImpact Decimal? @db.Decimal(16, 2)
  impactUnit      String?
  basis           String?
}

model SemenEvent {
  id        String   @id @default(uuid())
  farm      Farm     @relation(fields: [farmId], references: [id])
  farmId    String
  date      DateTime
  bullId    String // animal externalId
  event     String // collection | sale_direct | sale_distributor | internal_ai ...
  straws    Int
  costCents BigInt?
  dataType  String?
}

model BullValuation {
  id                String   @id @default(uuid())
  farm              Farm     @relation(fields: [farmId], references: [id])
  farmId            String
  animalId          String // animal externalId
  name              String?
  asOf              DateTime
  marketValueCents  BigInt
  insuredValueCents BigInt?
  ageYears          Decimal? @db.Decimal(6, 2)
  strawsOnHand      Int?
  method            String?
}

model ReproductionYear {
  id     String @id @default(uuid())
  farm   Farm   @relation(fields: [farmId], references: [id])
  farmId String
  year   Int
  data   Json // conception, calving, survival, weaning rates & weights

  @@unique([farmId, year])
}

model ProcessedAnimal {
  id           String    @id @default(uuid())
  farm         Farm      @relation(fields: [farmId], references: [id])
  farmId       String
  animalId     String // animal externalId
  enterpriseId String?
  species      String?
  processedAt  DateTime?
  revenueCents BigInt?
  data         Json // weights, dress %, cost breakdown
}

/// The dataset's expected insights; used to grade the insights engine (Phase 16).
model InsightReference {
  id             String  @id @default(uuid())
  farm           Farm    @relation(fields: [farmId], references: [id])
  farmId         String
  externalId     String
  severity       String
  category       String?
  title          String
  finding        String?
  recommendation String?
  keyMetrics     Json?
  sourceTables   String?
}

/// Monthly herd reconciliation by class. Class changes (calf -> heifer -> cow) are not
/// recoverable from the animal registry alone, so the monthly roll is stored as a record.
model HerdFlowMonth {
  id           String   @id @default(uuid())
  farm         Farm     @relation(fields: [farmId], references: [id])
  farmId       String
  monthEnd     DateTime
  species      String
  animalClass  String
  category     String?
  opening      Int
  births       Int      @default(0)
  purchases    Int      @default(0)
  transfersIn  Int      @default(0)
  transfersOut Int      @default(0)
  deaths       Int      @default(0)
  cullsSold    Int      @default(0)
  sales        Int      @default(0)
  processed    Int      @default(0)
  householdUse Int      @default(0)
  ending       Int

  @@index([farmId, monthEnd])
}

/// Market value of the land base over time (balance-sheet memo; land is carried at cost).
model LandValuation {
  id               String   @id @default(uuid())
  farm             Farm     @relation(fields: [farmId], references: [id])
  farmId           String
  asOf             DateTime
  marketValueCents BigInt
  source           String?

  @@unique([farmId, asOf])
}
