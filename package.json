{
  "name": "field-and-ledger",
  "private": true,
  "version": "0.1.0",
  "description": "Farm & ranch accounting and financial planning.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @fl/db generate",
    "db:migrate": "pnpm --filter @fl/db migrate",
    "db:studio": "pnpm --filter @fl/db studio",
    "db:seed": "pnpm --filter @fl/db seed"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "prettier": "^3.3.3"
  },
  "engines": { "node": ">=20" }
}
